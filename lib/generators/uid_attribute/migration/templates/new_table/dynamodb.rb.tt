# frozen_string_literal: true

# Creates the <%= table_name %> DynamoDB table.
#
<% if as_pk? -%>
# UUID is the partition key. Generate values Ruby-side via
# UidAttribute::Generator before each PutItem call.
<% else -%>
# Uses an integer "id" partition key (string-encoded) and a GSI on
# <%= column_name %> for UUID lookups.
<% end -%>
#
# Capacity mode: PAY_PER_REQUEST (on-demand). For provisioned mode,
# replace billing_mode with provisioned_throughput parameters.
#
# Requires the aws-sdk-dynamodb gem.
require "aws-sdk-dynamodb"
require "uid_attribute"

class Create<%= table_name.camelize %>
  TABLE_NAME = "<%= table_name %>"
<% unless as_pk? -%>
  INDEX_NAME = "<%= table_name %>_<%= column_name %>_index"
<% end -%>

  def self.up(client: Aws::DynamoDB::Client.new)
<% if as_pk? -%>
    client.create_table(
      table_name: TABLE_NAME,
      billing_mode: "PAY_PER_REQUEST",
      attribute_definitions: [
        {attribute_name: "<%= column_name %>", attribute_type: "S"}
      ],
      key_schema: [
        {attribute_name: "<%= column_name %>", key_type: "HASH"}
      ]
    )
<% else -%>
    client.create_table(
      table_name: TABLE_NAME,
      billing_mode: "PAY_PER_REQUEST",
      attribute_definitions: [
        {attribute_name: "id", attribute_type: "S"},
        {attribute_name: "<%= column_name %>", attribute_type: "S"}
      ],
      key_schema: [
        {attribute_name: "id", key_type: "HASH"}
      ],
      global_secondary_indexes: [
        {
          index_name: INDEX_NAME,
          key_schema: [
            {attribute_name: "<%= column_name %>", key_type: "HASH"}
          ],
          projection: {projection_type: "ALL"}
        }
      ]
    )
<% end -%>

    client.wait_until(:table_exists, table_name: TABLE_NAME)
    puts "Table #{TABLE_NAME} created."
  end

  def self.down(client: Aws::DynamoDB::Client.new)
    client.delete_table(table_name: TABLE_NAME)
    client.wait_until(:table_not_exists, table_name: TABLE_NAME)
  end
end
