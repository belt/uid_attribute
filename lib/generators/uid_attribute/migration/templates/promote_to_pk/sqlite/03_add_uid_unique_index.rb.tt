# frozen_string_literal: true

# Step 3 of 4 — promote <%= table_name %> primary key from integer to UUID.
#
# Validates uniqueness and locks the column NOT NULL. SQLite enforces
# NOT NULL via a table rebuild under the hood (ActiveRecord handles this).
class AddUidUniqueIndexTo<%= table_name.camelize %> < ActiveRecord::Migration[<%= migration_version %>]
  def up
    add_index :<%= table_name %>, :<%= column_name %>,
      unique: true,
      if_not_exists: true,
      name: "index_<%= table_name %>_on_<%= column_name %>_unique"

    change_column_null :<%= table_name %>, :<%= column_name %>, false
  end

  def down
    if index_exists?(:<%= table_name %>, :<%= column_name %>, name: "index_<%= table_name %>_on_<%= column_name %>_unique")
      remove_index :<%= table_name %>, name: "index_<%= table_name %>_on_<%= column_name %>_unique"
    end
    change_column_null :<%= table_name %>, :<%= column_name %>, true
  end
end
