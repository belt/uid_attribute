# frozen_string_literal: true

# Backfills <%= column_name %> on <%= table_name %> in batches.
#
# Uses UidAttribute::Generator (UUID v<%= uuid_version %>) for unique values per row.
# After this migration validates coverage, mark the column NOT NULL in a
# follow-up migration (kept separate to avoid blocking writes during backfill).
#
#   change_column_null :<%= table_name %>, :<%= column_name %>, false
class <%= backfill_class_name %> < ActiveRecord::Migration[<%= migration_version %>]
  disable_ddl_transaction!

  BATCH_SIZE = <%= batch_size %>
  UID_VERSION = <%= uuid_version %>

  class <%= class_name %>BackfillRecord < ActiveRecord::Base
    self.table_name = "<%= table_name %>"
    self.inheritance_column = :_type_disabled
  end

  def up
    require "uid_attribute"

    loop do
      ids = <%= class_name %>BackfillRecord
        .where(<%= column_name %>: nil)
        .limit(BATCH_SIZE)
        .pluck(:id)
      break if ids.empty?

      <%= class_name %>BackfillRecord.transaction do
        ids.each do |id|
          <%= class_name %>BackfillRecord
            .where(id: id)
            .update_all(<%= column_name %>: UidAttribute::Generator.generate(version: UID_VERSION))
        end
      end
    end
  end

  def down
    raise ActiveRecord::IrreversibleMigration
  end
end
