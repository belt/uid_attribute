# frozen_string_literal: true

# Backfills <%= column_name %> on <%= table_name %> in batches.
#
# MySQL InnoDB: keep batch size modest to avoid long-running transactions
# that hold gap locks under REPEATABLE READ. Read-committed isolation
# eliminates most gap locks if your application can tolerate it.
<% if mysql_binary16? -%>
#
# Storage is BINARY(16); the canonical hyphenated UUID string is converted
# to bytes via [str.delete("-")].pack("H*") before INSERT/UPDATE.
<% end -%>
class <%= backfill_class_name %> < ActiveRecord::Migration[<%= migration_version %>]
  BATCH_SIZE = <%= batch_size %>
  UID_VERSION = <%= uuid_version %>

  class <%= class_name %>BackfillRecord < ActiveRecord::Base
    self.table_name = "<%= table_name %>"
    self.inheritance_column = :_type_disabled
  end

  def up
    require "uid_attribute"

    loop do
      ids = <%= class_name %>BackfillRecord
        .where(<%= column_name %>: nil)
        .limit(BATCH_SIZE)
        .pluck(:id)
      break if ids.empty?

      <%= class_name %>BackfillRecord.transaction do
        ids.each do |id|
          uid_str = UidAttribute::Generator.generate(version: UID_VERSION)
<% if mysql_binary16? -%>
          uid_value = [uid_str.delete("-")].pack("H*")
<% else -%>
          uid_value = uid_str
<% end -%>
          <%= class_name %>BackfillRecord
            .where(id: id)
            .update_all(<%= column_name %>: uid_value)
        end
      end
    end
  end

  def down
    raise ActiveRecord::IrreversibleMigration
  end
end
